<Project>
  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == '' and '$(OS)' == 'Windows_NT' and Exists('R:/BigCityLegacy/prod_game/game_Data/Managed')">R:\BigCityLegacy\prod_game</GameDir>
    <!-- Optional overrides; use the assemblies from the same BCL installation. -->
